{
  "opencollection": "1.0.0",
  "info": {
    "name": "Forum Account API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "FORUM-ACCESS-KEY",
      "value": "{{FORUM-ACCESS-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get account summary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.forum.market/v1/account",
            "auth": {
              "type": "apikey",
              "key": "FORUM-ACCESS-KEY",
              "value": "{{FORUM-ACCESS-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Returns account summary including balances, margin, PnL, and account health status. Requires `read` permission."
        }
      ]
    }
  ],
  "bundled": true
}